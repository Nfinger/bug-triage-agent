{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "radial-epoch",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	// One uniquely tagged migration per Flue agent class (append-only — never
	// rewrite deployed entries), plus the shared Sandbox container class.
	"migrations": [
		{ "tag": "flue-class-FlueBugTriageAgent", "new_sqlite_classes": ["FlueBugTriageAgent"] },
		{ "tag": "flue-class-FlueCodingAgent", "new_sqlite_classes": ["FlueCodingAgent"] },
		{ "tag": "sandbox-v1", "new_sqlite_classes": ["Sandbox"] }
	],
	"durable_objects": {
		"bindings": [{ "class_name": "Sandbox", "name": "Sandbox" }]
	},
	"containers": [{ "class_name": "Sandbox", "image": "./Dockerfile" }],
	"observability": {
		"enabled": true,
		"traces": { "enabled": true }
	}
}
