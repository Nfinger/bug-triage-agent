{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "bug-triage-agent",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	// One uniquely tagged migration per Flue agent class (append-only — never
	// rewrite deployed entries), plus the shared Sandbox container class.
	"migrations": [
		// This worker previously ran a Hello agent (a stray deploy from before
		// the project's real Cloudflare setup landed on main). Its creation and
		// deletion both stay in this history — wrangler validates a
		// deleted_classes entry against the local migration history, not live
		// server state, so the create entry must remain even though the class
		// no longer exists in the bundle.
		{ "tag": "flue-class-FlueHelloAgent", "new_sqlite_classes": ["FlueHelloAgent"] },
		{ "tag": "flue-class-FlueBugTriageAgent", "new_sqlite_classes": ["FlueBugTriageAgent"] },
		{ "tag": "flue-class-FlueCodingAgent", "new_sqlite_classes": ["FlueCodingAgent"] },
		{ "tag": "sandbox-v1", "new_sqlite_classes": ["Sandbox"] },
		{ "tag": "delete-flue-hello-agent", "deleted_classes": ["FlueHelloAgent"] },
		{ "tag": "flue-class-FlueArchitectureReviewAgent", "new_sqlite_classes": ["FlueArchitectureReviewAgent"] },
		{ "tag": "flue-class-FlueProspectingAgent", "new_sqlite_classes": ["FlueProspectingAgent"] }
	],
	// Cloudflare evaluates cron expressions in UTC only — there is no timezone
	// option. Fires arrive in src/cloudflare.ts, which routes by expression
	// (keep these in sync with CRON there):
	//   "0 9 * * 5"    weekly architecture review, Friday 09:00 UTC
	//   "0 13 * * 1-5" daily prospecting, weekdays 13:00 UTC
	"triggers": {
		"crons": ["0 9 * * 5", "0 13 * * 1-5"]
	},
	"durable_objects": {
		"bindings": [{ "class_name": "Sandbox", "name": "Sandbox" }]
	},
	// CAPACITY (2026-08-16 incident): every labeled issue pins one container
	// instance for up to its full three-hour budget (sleepAfter: '3h').
	// - instance_type "standard-1" (4 GiB / half vCPU): the default "lite"
	//   tier starved installs/builds/tests of a ~1,500-package Node repo,
	//   showing up as pnpm stalls and hours-long single commands.
	// - max_instances 10: sized to the observed 10-issue dispatch batches.
	//   Ten concurrent standard-1 instances must fit the account plan's
	//   container allowance; past either limit, new sandboxes fail admission
	//   immediately and the agent fails closed (breaker + blocker comment).
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "./Dockerfile",
			"instance_type": "standard-1",
			"max_instances": 10
		}
	],
	"observability": {
		"enabled": true,
		"traces": { "enabled": true }
	}
}
