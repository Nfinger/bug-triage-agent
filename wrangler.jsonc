{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "bug-triage-agent",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	// One uniquely tagged migration per Flue agent class (append-only — never
	// rewrite deployed entries), plus the shared Sandbox container class.
	"migrations": [
		// This worker previously ran a Hello agent (a stray deploy from before
		// the project's real Cloudflare setup landed on main). Its creation and
		// deletion both stay in this history — wrangler validates a
		// deleted_classes entry against the local migration history, not live
		// server state, so the create entry must remain even though the class
		// no longer exists in the bundle.
		{ "tag": "flue-class-FlueHelloAgent", "new_sqlite_classes": ["FlueHelloAgent"] },
		{ "tag": "flue-class-FlueBugTriageAgent", "new_sqlite_classes": ["FlueBugTriageAgent"] },
		{ "tag": "flue-class-FlueCodingAgent", "new_sqlite_classes": ["FlueCodingAgent"] },
		{ "tag": "sandbox-v1", "new_sqlite_classes": ["Sandbox"] },
		{ "tag": "delete-flue-hello-agent", "deleted_classes": ["FlueHelloAgent"] },
		{ "tag": "flue-class-FlueArchitectureReviewAgent", "new_sqlite_classes": ["FlueArchitectureReviewAgent"] }
	],
	// Weekly architecture review: Friday 09:00 UTC. Cloudflare evaluates cron
	// expressions in UTC only — there is no timezone option. The fire arrives in
	// src/cloudflare.ts and dispatches one ArchitectureReview run.
	"triggers": {
		"crons": ["0 9 * * 5"]
	},
	"durable_objects": {
		"bindings": [{ "class_name": "Sandbox", "name": "Sandbox" }]
	},
	// CAPACITY NOTE (2026-08-16 incident): every labeled issue pins one
	// container instance for up to its full three-hour budget (sleepAfter:
	// '3h'). A batch of concurrent dispatches can exhaust the account's
	// container instance allowance, after which new sandboxes fail every
	// operation immediately (max_container_instances_exceeded /
	// no_container_instance_available). The agent now fails closed when that
	// happens (breaker + blocker comment), but if batches of 10+ issues are
	// routine, raise this app's "max_instances" to match the plan's allowance
	// or throttle label application upstream.
	"containers": [{ "class_name": "Sandbox", "image": "./Dockerfile" }],
	"observability": {
		"enabled": true,
		"traces": { "enabled": true }
	}
}
