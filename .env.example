# Model provider API key (loaded automatically by `flue run` and `vite dev`).
# The BugTriage agent runs on openrouter/moonshotai/kimi-k2.6; the
# ArchitectureReview agent on openrouter/anthropic/claude-opus-5.
OPENROUTER_API_KEY=""

# Slack channel ingress
# Signing secret from your Slack app's "Basic Information" page — used to
# verify Events API deliveries at /channels/slack/events.
SLACK_SIGNING_SECRET=""
# Channel ID of the Slack channel to read bug reports from (e.g. C0123456789).
SLACK_BUG_CHANNEL_ID=""

# GitHub issue filing + coding agent
# Fine-grained token on the target repository with Issues: Read/write,
# Contents: Read/write, and Pull requests: Read/write (the coding agent
# clones, pushes its work branch, and opens PRs with it; the weekly
# architecture review reads repository contents with the same token).
GITHUB_TOKEN=""
# Repository that receives bug-report issues and architecture-review reports,
# as "owner/repo".
GITHUB_REPO=""

# Coding-agent pipeline (issue → sandbox → PR)
# Secret configured on the repository webhook that posts Issues events to
# /channels/github/webhook.
GITHUB_WEBHOOK_SECRET=""
# Label that opts an issue into the coding agent. Defaults to "agent-fix".
CODING_AGENT_LABEL=""

# Weekly architecture review
# When it fires is set in wrangler.jsonc ("triggers.crons"), which Cloudflare
# evaluates in UTC — not here. Set this to "false" to skip scheduled runs.
ARCH_REVIEW_ENABLED=""
# Label applied to filed reports; also how past reports are found again.
ARCH_REVIEW_LABEL="architecture-review"
# Repository the review reads, as "owner/repo". Defaults to GITHUB_REPO —
# set it only when the code under review lives outside the tracker repo.
ARCH_REVIEW_REPO=""
