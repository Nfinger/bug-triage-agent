# Model provider API key (loaded automatically by `flue run` and `vite dev`).
# The BugTriage agent runs on openrouter/moonshotai/kimi-k2.6; the
# ArchitectureReview agent on openrouter/anthropic/claude-opus-5.
OPENROUTER_API_KEY=""

# Slack channel ingress
# Signing secret from your Slack app's "Basic Information" page — used to
# verify Events API deliveries at /channels/slack/events.
SLACK_SIGNING_SECRET=""
# Channel ID of the Slack channel to read bug reports from (e.g. C0123456789).
SLACK_BUG_CHANNEL_ID=""

# GitHub issue filing + coding agent
# Fine-grained token on the target repository with Issues: Read/write,
# Contents: Read/write, and Pull requests: Read/write (the coding agent
# clones, pushes its work branch, and opens PRs with it; the weekly
# architecture review reads repository contents with the same token).
GITHUB_TOKEN=""
# Repository that receives bug-report issues and architecture-review reports,
# as "owner/repo".
GITHUB_REPO=""

# Coding-agent pipeline (issue → sandbox → PR)
# Secret configured on the repository webhook that posts Issues events to
# /channels/github/webhook.
GITHUB_WEBHOOK_SECRET=""
# Label that opts an issue into the coding agent. Defaults to "agent-fix".
CODING_AGENT_LABEL=""

# Weekly architecture review
# When it fires is set in wrangler.jsonc ("triggers.crons"), which Cloudflare
# evaluates in UTC — not here. Set this to "false" to skip scheduled runs.
ARCH_REVIEW_ENABLED=""
# Label applied to filed reports; also how past reports are found again.
ARCH_REVIEW_LABEL="architecture-review"
# Repository the review reads, as "owner/repo". Defaults to GITHUB_REPO —
# set it only when the code under review lives outside the tracker repo.
ARCH_REVIEW_REPO=""

# Daily prospecting (HubSpot → research → personalized outreach)
# When it fires is set in wrangler.jsonc ("triggers.crons", weekdays 13:00
# UTC). Set this to "false" to skip scheduled runs entirely.
PROSPECTING_ENABLED=""
# Whether composed emails are actually sent. Defaults to false: the run then
# stores every message as a draft note on the contact in HubSpot, so the
# pipeline can be watched in the CRM before any email leaves.
OUTREACH_ENABLED=""
# Companies selected per run (default 5, max 50).
PROSPECTING_BATCH_SIZE=""
# Emails actually sent per run; the rest become drafts (default 5).
OUTREACH_DAILY_CAP=""
# Days before a company or contact may be prospected again (default 30).
OUTREACH_COOLDOWN_DAYS=""
# Contacts emailed per selected company (default 1).
OUTREACH_CONTACTS_PER_COMPANY=""
# Days of CRM activity counted as a buying signal (default 30).
PROSPECTING_LOOKBACK_DAYS=""
# HubSpot private-app access token. Scopes: crm.objects.companies.read/write,
# crm.objects.contacts.read/write, crm.objects.deals.read, crm.schemas.*.read,
# sales-email-read, transactional-email. Fixes the portal every tool uses.
HUBSPOT_ACCESS_TOKEN=""
# Verified HubSpot sending address the outreach goes out from.
HUBSPOT_SENDER_EMAIL=""
# Transactional email template id (Marketing → Email → transactional) whose
# body renders {{ custom.body }} and carries the legal/unsubscribe footer.
# Required only when OUTREACH_ENABLED=true.
HUBSPOT_OUTREACH_TEMPLATE_ID=""
# Slack bot token (chat:write) and channel that receives each run's summary.
SLACK_BOT_TOKEN=""
SLACK_PROSPECTING_CHANNEL_ID=""
# Brave Search API key for the web_search research tool.
WEB_SEARCH_API_KEY=""
